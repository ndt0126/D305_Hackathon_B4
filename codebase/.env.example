# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit real keys.

# --- OpenAI ---
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o-mini
# true  -> deterministic offline mock (no API key needed; used by tests/demo)
# false -> real OpenAI calls
USE_MOCK_LLM=true

# Optional: path to a text file that overrides the built-in Vietnamese
# system prompt (app/llm/prompts.py). Leave unset to use the built-in one.
# SYSTEM_PROMPT_FILE=prompts/system_prompt.txt

# --- Discord export tool API (coworker's service) ---
# PLACEHOLDER: the real endpoint is confidential. Replace both values when
# the endpoint is shared. See app/integrations/discord_export.py.
DISCORD_EXPORT_API_URL=https://example.invalid/api/export
DISCORD_EXPORT_API_KEY=REPLACE_ME

# --- Inbound auth (public deployment) ---
# When the service is exposed publicly (e.g. Cloudflare Tunnel), set a long
# random string here and share it privately with the Discord tool's owner.
# Every report request must then carry it in the "X-API-Key" header.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave empty to disable auth for local development.
SERVICE_API_KEY=

# --- App ---
LOG_LEVEL=INFO
